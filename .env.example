# Supabase project connection, used only server-side (src/lib/supabase-server.ts).
# There is no NEXT_PUBLIC_ variant on purpose: the app has no end-user auth yet,
# so the `tenders` table has RLS enabled with no policies — only the service
# role key (kept server-side) can read/write it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
