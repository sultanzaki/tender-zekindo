# Supabase project connection.
#
# SUPABASE_SERVICE_ROLE_KEY is used server-side only (src/lib/supabase-server.ts)
# for everything the app touches — tenders, profiles, sessions, all of it.
# There is no NEXT_PUBLIC_ variant on purpose, and no anon key at all: this
# app doesn't use Supabase Auth (see src/lib/auth/session.ts for the
# self-hosted email+password auth instead), so nothing needs public access.
# Every table has RLS enabled with no policies — only this key can read/write.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
